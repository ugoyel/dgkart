# Where the website gets its data:
#   demo = runs entirely in the browser with the sample catalogue (no server needed)
#   api  = the DGkart API (backend/), same one the Android app uses
VITE_DATA_MODE=demo
# API base URL (no trailing slash), used when VITE_DATA_MODE=api
VITE_API_BASE_URL=http://localhost:3000
# browser = clean URLs (/product/123) and needs the host to serve index.html for every path
# hash    = /#/product/123, works on any static host with no setup
VITE_ROUTER=browser
# Sub-folder the site is served from, e.g. /shop/ (default /)
VITE_BASE_PATH=/
# Firebase web config (only when the API runs AUTH_MODE=firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
