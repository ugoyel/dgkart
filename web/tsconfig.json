{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": { "@engine": ["../backend/src/modules/promotions/engine/index.ts"] }
  },
  "include": ["src", "vite.config.ts", "../backend/src/modules/promotions/engine/*.ts"],
  "exclude": ["../backend/src/modules/promotions/engine/*.spec.ts"]
}
