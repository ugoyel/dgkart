# --- Server ---
PORT=3000
NODE_ENV=development
# Public base URL of this API, used to build image URLs (no trailing slash)
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=*

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://dgkart:dgkart@localhost:5432/dgkart
# true only for local dev; use migrations in production
DB_SYNC=true

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# The admin's mobile number. Any login with this number gets the ADMIN role.
ADMIN_PHONE=+919910123503
# firebase = verify Firebase Phone Auth ID tokens (production)
# dev      = backend issues a fixed OTP (DEV_OTP_CODE) for local testing only
AUTH_MODE=dev
DEV_OTP_CODE=123456
# Firebase service account (JSON string, or path via GOOGLE_APPLICATION_CREDENTIALS)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Payments ---
# razorpay = real Razorpay (test or live keys); mock = auto-approve for local dev
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Storage ---
# local disk folder for uploaded product images (swap for S3/GCS via StorageService)
UPLOAD_DIR=./uploads

# --- Import ---
IMPORT_BATCH_SIZE=500
# Seed this many dummy products on first boot if the catalog is empty (0 = off)
SEED_ON_BOOT=1000

# --- Image storage driver ---
# local = disk on the API server (fine for dev; most free hosts wipe disk on redeploy)
# s3    = any S3-compatible bucket: AWS S3, Cloudflare R2 (10 GB free), Backblaze B2, MinIO
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL prefix the bucket is served from, e.g. https://pub-xxxx.r2.dev
S3_PUBLIC_URL=
