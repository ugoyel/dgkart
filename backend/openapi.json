  "info": {
    "title": "DGkart API",
    "description": "REST API shared by the DKKart mobile app and the future DGkart.com website.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "AddressDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "pincode": {
            "type": "string"
          },
          "isDefault": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "phone",
          "line1",
          "city",
          "state",
          "pincode"
        ]
      },
      "AddressesDto": {
        "type": "object",
        "properties": {
          "addresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddressDto"
            }
          }
        },
        "required": [
          "addresses"
        ]
      },
      "FirebaseLoginDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string"
          }
        },
        "required": [
          "idToken"
        ]
      },
      "OtpRequestDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "9910123503"
          }
        },
        "required": [
          "phone"
        ]
      },
      "OtpVerifyDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "9910123503"
          },
          "code": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "AddToCartDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "quantity": {
            "type": "object",
            "default": 1
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      },
      "QuantityDto": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "number"
          }
        },
        "required": [
          "quantity"
        ]
      },
      "LineDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      },
      "PlaceOrderDto": {
        "type": "object",
        "properties": {
          "address": {
            "$ref": "#/components/schemas/AddressDto"
          },
          "paymentMethod": {
            "type": "string",
            "enum": [
              "ONLINE",
              "COD"
            ]
          },
          "items": {
            "description": "Buy It Now items; omit to check out the cart",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineDto"
            }
          }
        },
        "required": [
          "address",
          "paymentMethod"
        ]
      },
      "CheckoutDto": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          }
        },
        "required": [
          "orderId"
        ]
      },
      "ConfirmDto": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "gatewayOrderId": {
            "type": "string"
          },
          "paymentId": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        },
        "required": [
          "orderId",
          "gatewayOrderId",
          "paymentId",
          "signature"
        ]
      },
      "SeedDto": {
        "type": "object",
        "properties": {
          "count": {
            "type": "object",
            "default": 1000,
            "maximum": 50000
          }
        },
        "required": [
          "count"
        ]
      },
      "WipeAllDto": {
        "type": "object",
        "properties": {
          "confirm": {
            "type": "string",
            "description": "Must be the word DELETE"
          }
        },
        "required": [
          "confirm"
        ]
      },
      "ProductDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "mrp": {
            "type": "number"
          },
          "stock": {
            "type": "number"
          },
          "condition": {
            "type": "string",
            "enum": [
              "NEW",
              "OPEN_BOX",
              "REFURBISHED",
              "USED"
            ]
          },
          "freeShipping": {
            "type": "boolean"
          },
          "isActive": {
            "type": "boolean"
          },
          "specs": {
            "type": "object"
          }
        },
        "required": [
          "sku",
          "title",
          "price",
          "stock"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "mrp": {
            "type": "number"
          },
          "stock": {
            "type": "number"
          },
          "condition": {
            "type": "string",
            "enum": [
              "NEW",
              "OPEN_BOX",
              "REFURBISHED",
              "USED"
            ]
          },
          "freeShipping": {
            "type": "boolean"
          },
          "isActive": {
            "type": "boolean"
          },
          "specs": {
            "type": "object"
          }
        }
      },
      "StatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PENDING_PAYMENT",
              "PAID",
              "PAYMENT_FAILED",
              "CONFIRMED_COD",
              "SHIPPED",
              "DELIVERED",
              "CANCELLED"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}